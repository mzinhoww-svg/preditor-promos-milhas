# Copie para .env.local (nunca commitar). Sem base configurada o dashboard usa dashboard/mock/
# e mostra "Dados simulados". A chave é lida só no servidor; nunca use NEXT_PUBLIC_ nela.
PREDITOR_DATA_SOURCE=mock
PREDITOR_API_BASE_URL=
# Alternativa aceita para a base (também lida só no servidor): NEXT_PUBLIC_API_BASE_URL=
PREDITOR_API_KEY=
