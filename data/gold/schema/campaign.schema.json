{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mzinhoww-svg/preditor-promos-milhas/data/gold/schema/campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "split", "status", "block", "origin", "destination", "event_type", "segmented", "segment_label",
               "start_at", "start_inferred", "end_at", "bonus_pct", "bumerangue_pct", "first_seen_at", "evidence_ids",
               "n_sources", "validated", "date_conflict", "relation", "all_evidence_gap", "tags", "notes"],
  "properties": {
    "campaign_id": {"type": "string", "pattern": "^c-[0-9]{4}$"},
    "split": {"enum": ["dev", "test"]},
    "status": {"enum": ["gold_provisional", "gold_verified"]},
    "block": {"enum": ["A", "B"]},
    "origin": {"enum": ["livelo", "esfera", "latam_pass", "smiles", "azul_fidelidade", null]},
    "destination": {"enum": ["livelo", "esfera", "latam_pass", "smiles", "azul_fidelidade"]},
    "event_type": {"enum": ["transfer_bonus", "purchase_discount", "boosted_accrual"]},
    "segmented": {"type": "boolean"},
    "segment_label": {"type": ["string", "null"], "maxLength": 60},
    "start_at": {"type": "string", "format": "date"},
    "start_inferred": {"type": "boolean"},
    "end_at": {"type": ["string", "null"], "format": "date"},
    "bonus_pct": {"type": ["number", "null"], "minimum": 1, "maximum": 300},
    "bumerangue_pct": {"type": ["number", "null"], "minimum": 1, "maximum": 300},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^m-[0-9]{4}$"}},
    "n_sources": {"type": "integer", "minimum": 1},
    "validated": {"type": "boolean"},
    "date_conflict": {"type": "boolean"},
    "relation": {"enum": ["new", "renewal", "extension"]},
    "all_evidence_gap": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
